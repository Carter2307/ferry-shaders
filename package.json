{
  "name": "shader-ui",
  "version": "0.1.0",
  "description": "shader-ui: WebGPU background shaders for React. Every shader declares its parameters (colors, numbers, booleans, selects), so a panel can configure it live.",
  "type": "module",
  "license": "MIT",
  "author": "B.ROGER",
  "keywords": [
    "react",
    "webgpu",
    "wgsl",
    "shader",
    "background",
    "dither"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./shaders": {
      "types": "./dist/shaders/index.d.ts",
      "default": "./dist/shaders/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --config site/vite.config.ts --port 5182",
    "build": "rm -rf dist && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/add-dts-extensions.mjs && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ferry-ui": "^0.1.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sugar-high": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "webgpu": "^0.6.2"
  }
}
