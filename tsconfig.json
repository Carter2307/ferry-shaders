{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "node", "@webgpu/types"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* The site and the tests import the library by its package name: resolve it to the sources. */
    "paths": {
      "ferry-shaders": ["./src/index.ts"],
      "ferry-shaders/core": ["./src/core/index.ts"],
      "ferry-shaders/shaders": ["./src/shaders/index.ts"]
    },

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test", "site/src", "site/vite.config.ts", "vite.lib.config.ts", "vitest.config.ts", "scripts"]
}
